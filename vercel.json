{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "delta": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.delta",
      "bindings": [
        {
          "type": "service",
          "service": "january",
          "format": "url",
          "env": "JANUARY_URL"
        }
      ]
    },
    "bonfire": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.bonfire"
    },
    "autumn": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.autumn"
    },
    "january": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.january"
    },
    "gifbox": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.gifbox"
    },
    "voice-ingress": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.voice-ingress"
    },
    "docs": {
      "root": "docs",
      "framework": "docusaurus-2"
    }
  },
  "daemons": {
    "pushd": {
      "root": ".",
      "entrypoint": "Dockerfile.pushd",
      "instances": { "iad1": 1 }
    },
    "crond": {
      "root": ".",
      "entrypoint": "Dockerfile.crond",
      "instances": { "iad1": 1 }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "delta" }
    },
    {
      "source": "/ws",
      "destination": { "service": "bonfire" }
    },
    {
      "source": "/ws/(.*)",
      "destination": { "service": "bonfire" }
    },
    {
      "source": "/autumn/(.*)",
      "destination": { "service": "autumn" }
    },
    {
      "source": "/january/(.*)",
      "destination": { "service": "january" }
    },
    {
      "source": "/gifbox/(.*)",
      "destination": { "service": "gifbox" }
    },
    {
      "source": "/ingress/(.*)",
      "destination": { "service": "voice-ingress" }
    },
    {
      "source": "/docs/(.*)",
      "destination": { "service": "docs" }
    }
  ]
}
